{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": { "root": "MERN/client", "framework": "vite" },
    "server": { "root": "MERN/server", "framework": "express" }
  },
  "rewrites": [
    { "source": "/students/:path*", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}